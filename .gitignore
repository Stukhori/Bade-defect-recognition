# Python environments and caches
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Editors and operating-system noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Dataset payloads and derived image caches; directory policy remains tracked
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep
!data/processed/wtbd_crops_v1/
!data/processed/wtbd_crops_v1/*.csv
!data/processed/wtbd_crops_v1/*.json
!data/processed/wtbd_crops_v1/resolved_config.yaml
!data/processed/wtbd_crops_v1/README.md
data/processed/wtbd_crops_v1/images/**

# Large model artifacts
*.ckpt
*.onnx
*.pt
*.pth

# Automatically generated per-run artifacts. Curated small summaries belong in
# experiments/summaries/ and remain versionable.
experiments/results/**
!experiments/results/.gitkeep
experiments/cache/**

# Logs outside ignored run directories
*.log
*.joblib

# Local review-transfer bundles (versioned contents live under data/metadata)
phase2_human_review_artifacts_*.zip
